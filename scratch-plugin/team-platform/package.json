{
  "name": "dsh-team-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "login.html",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build:host": "tsdown --no-config src/index.ts --format esm --platform node --out-dir lib",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build": "pnpm run build:host && pnpm run build:client",
    "dev:client": "tsdown --config tsdown.client.config.ts --watch"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../../vendor/cordis",
    "@deepseek-ai/dsh-session": "link:../../packages/core/session"
  },
  "devDependencies": {
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "@deepseek-ai/dsh-client-runtime": "link:../../packages/client/runtime",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-sidebar": "link:../../packages/client/ui-sidebar",

    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0"
  }
}
